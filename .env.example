# Copie para .env (cp .env.example .env). NUNCA versione o .env.

# Banco de dados (libSQL/SQLite).
# Desenvolvimento: arquivo local. Produção: URL do Turso (libsql://<db>.turso.io)
DATABASE_URL="file:./data/escala.db"
# Somente produção (Turso). Deixe vazio em desenvolvimento.
DATABASE_AUTH_TOKEN=""

# Exibe as contas de demonstração na tela de login. Use "false" em produção.
DEMO_MODE="true"

# URL pública do app (usada em links de compartilhamento).
APP_URL="http://localhost:3000"

# Proteção contra execução acidental do seed em produção.
# O seed só roda se NODE_ENV != production OU se ALLOW_SEED="true".
ALLOW_SEED="false"
